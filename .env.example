# ---------------------------------------------------------------------------
# openbank-home configuration template
#
#   cp .env.example .env
#   chmod 600 .env
#   $EDITOR .env
#
# `.env` is ignored by Git. Never commit real values to this template.
# ---------------------------------------------------------------------------

# === Actual Budget ==========================================================
ACTUAL_PORT=5006
ACTUAL_TRUSTED_PROXIES=127.0.0.1/32,::1/128
ACTUAL_UPLOAD_FILE_SYNC_SIZE_LIMIT_MB=20
ACTUAL_UPLOAD_SYNC_ENCRYPTED_FILE_SYNC_SIZE_LIMIT_MB=50
ACTUAL_UPLOAD_FILE_SIZE_LIMIT_MB=20
TZ=Europe/Rome

# === Tailscale ==============================================================
TS_HOSTNAME=raspberrypi.tailnet-XXXX.ts.net
TS_SERVE_HTTPS_PORT=443

# === Enable Banking =========================================================
# Actual asks for these through More -> Bank Sync. The server does not read
# these environment variables; they are private operator references only.
# Actual's documented integration requires a matching Production app ID and key.
ENABLE_BANKING_APP_ID=00000000-0000-0000-0000-000000000000

# Upload this credential through Actual's UI. It is deliberately not mounted
# into the container. Store it outside the repository where practical and run:
# chmod 400 <path>
ENABLE_BANKING_PEM_PATH=./secrets/enablebanking.pem
ENABLE_BANKING_REDIRECT_URL=https://raspberrypi.tailnet-XXXX.ts.net/enablebanking/auth_callback

# === Backups ================================================================
BACKUP_DIR=./backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
RCLONE_REMOTE=

# Strongly recommended: account.sqlite contains server-side bank-sync secrets
# that are not covered by Actual's client-side end-to-end encryption.
BACKUP_GPG_RECIPIENT=

# === PSD2 consent reminders =================================================
CONSENT_STATE_FILE=./config/local-consents.tsv
CONSENT_WARN_DAYS=14
